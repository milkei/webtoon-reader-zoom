{
  "manifest_version": 3,
  "name": "Webtoon Reader Zoom",
  "version": "0.5.0",
  "description": "웹툰 본문 이미지만 25~100%로 조절해요. 댓글과 메뉴 크기는 그대로 두고 화면 오른쪽 버튼으로 배율을 간편하게 바꿀 수 있어요.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "웹툰 본문 크기 설정",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://comic.naver.com/*"
      ],
      "js": [
        "content.js",
        "toolbar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "naver-webtoon-reader@sohee.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
